# =============================================================================
# Baby Games — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env com credenciais reais!

# ─── Supabase ────────────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL="https://SEU-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key-aqui"

# ─── Variáveis opcionais (usadas internamente pelo MCP/CI) ───────────────────
# Não são necessárias para rodar o frontend localmente

# SUPABASE_ACCESS_TOKEN="seu-access-token-supabase"
# SUPABASE_PROJECT_ID="seu-project-id"
